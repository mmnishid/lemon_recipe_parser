{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build lemon debug",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "-O0",
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-o",
        "${workspaceFolder}/lemon",
        "${workspaceFolder}/lemon.c"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
